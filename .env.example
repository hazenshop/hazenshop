# ==============================================================================
# HAZEN E-COMMERCE - ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local development or add to your hosting provider
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ADMIN AUTHENTICATION
# ------------------------------------------------------------------------------
# Passkey required to access the Store Management Portal (/admin/*).
# If not set, system defaults to a development fallback ('hazen2026').
ADMIN_PASSWORD=your_secure_admin_password_here

# ------------------------------------------------------------------------------
# 2. SUPABASE DATABASE & STORAGE (OPTIONAL FOR CLOUD PERSISTENCE)
# ------------------------------------------------------------------------------
# If left blank, the app will automatically use local JSON persistence in .data/
# For serverless production (e.g. Vercel), create a free Supabase project and paste credentials:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 3. STORE DOMAIN & CANONICAL URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://hazenshopbd.com

# ------------------------------------------------------------------------------
# 4. TELEGRAM BOT NOTIFICATIONS (OPTIONAL FALLBACK OR CONFIGURE IN ADMIN SETTINGS)
# ------------------------------------------------------------------------------
# Create a bot with @BotFather on Telegram, then get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# ------------------------------------------------------------------------------
# 5. CLOUDINARY ZERO-CARD FREE IMAGE CDN (PREVENTS SUPABASE STORAGE EGRESS CHARGES)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


